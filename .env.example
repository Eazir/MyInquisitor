# Server
SERVER_PORT=8080
ENVIRONMENT=development

# Database
DATABASE_URL=postgres://myinquisitor_app:myinquisitor_dev@localhost:5433/myinquisitor?sslmode=disable

# JWT
JWT_SECRET=change-me-to-a-secure-random-string-at-least-32-chars
JWT_ACCESS_EXPIRATION=30m
JWT_REFRESH_EXPIRATION=720h

# Encryption (AES-256-GCM - 64 hex characters = 32 bytes)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
